{
  "name": "smartnotes-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "SmartNotes-web",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=SmartNotes-web",
    "dev:backend": "npm run dev --workspace=backend",
    "build:web": "npm run build --workspace=SmartNotes-web",
    "build:backend": "npm run build --workspace=backend",
    "start:web": "npm run start --workspace=SmartNotes-web",
    "start:backend": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
