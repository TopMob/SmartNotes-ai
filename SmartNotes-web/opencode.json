{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".pnpm-store/**",
      ".npm/**",
      ".yarn/**",
      ".next/**",
      ".turbo/**",
      "dist/**",
      "out/**",
      "coverage/**",
      ".vercel/**",
      "*.log",
      "*.tsbuildinfo",
      ".env",
      ".env.*",
      "!.env.example",
      ".git/**",
      ".idea/**",
      ".vscode/**"
    ]
  },
    "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=<project-ref>",
      "enabled": true
    }
  }
}
